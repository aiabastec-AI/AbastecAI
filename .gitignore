# Ambiente e credenciais (nunca commitar)
.env
.env.local
.env.*.local

# Vercel
.vercel

# Dependências (quando o projeto ganhar um package.json)
node_modules

# Dados brutos baixados manualmente pra backfill (grandes demais/não fazem sentido versionar)
scripts/dados/

# Log e checkpoint de progresso do backfill de coordenadas (estado local de execução, não código)
scripts/backfill-coordenadas.log
scripts/backfill-coordenadas-progresso.json

# Idem, pra auditoria de precisão que revê o mesmo backlog + relatórios que ela gera
scripts/auditoria-coordenadas-progresso.json
scripts/auditoria-coordenadas-corrigidos.csv
scripts/auditoria-coordenadas-revisar.csv
scripts/auditoria-coordenadas.log

# Builds baixados da EAS (binários grandes, não fazem sentido versionar)
*.aab
*.apk

# credenciais locais (o arquivo real se chama env.local, sem ponto)
env.local
env.local.bak-*

# marketing: arquivos pesados ou pessoais (os textos e roteiros de social/ são versionados)
assets/UCG/
social/prints/
social/brutos/
social/output/**/*.mp4
social/output/**/*.wav
social/output/**/transcripts/
